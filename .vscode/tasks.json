{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Api/MFirewallApi/MFirewallApi.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoColor"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-avalonia",
            "command": "dotnet",
            "type":"process",
            "args": [
                "build",
                "${workspaceFolder}/AppUI/MFirewallAppUI.csproj",
                "/property:GenerateFullPaths=true"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}