            "program": "${workspaceFolder}/Api/MFirewallApi/bin/Debug/net10.0/MFirewallApi.dll",
            "args":[],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            
        },
        {
