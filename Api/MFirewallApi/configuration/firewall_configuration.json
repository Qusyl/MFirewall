{
  "FirewallConfiguration": {
    "RuleStrategy": "FIRST_MATCHING",
    "FirewallProtection": {
      "DestinationIpOptions": {
        "Enable": false,
        "DestinationAddress": ""
      },
      "DestinationPortOptions": {
        "Enable": false,
        "DestinationPort": 10808
      },
      "SourceIpOptions": {
        "Enable": false,
        "SourceAddress": ""
      },
      "SourcePortOptions": {
        "Enable": false,
        "SourcePort": 0
      },
      "ProtocolOptions": {
        "Enable": true,
        "Protocol": 1
      },
      "TcpPortScanOptions": {
        "Enable": false,
        "UniquePacketsThreshold": 10,
        "WindowSeconds": 3
      },
      "UdpPortScanOptions": {
        "Enable": false,
        "UniquePacketsThreshold": 10,
        "WindowSeconds": 3
      },
      "TcpSynFloodOptions": {
        "Enable": false,
        "MaxSynPackets": 100,
        "WindowSeconds": 3
      },
      "UdpFloodOptions": {
        "Enable": false,
        "MaxPackets": 300,
        "WindowSeconds": 3
      },
      "RateLimitOptions": {
        "Enable": false,
        "Algorithm": "FIXED_WINDOW",
        "TokenBucket": {
          "Enable": false,
          "Capacity": 100,
          "TokenPerSeconds": 50,
          "TokenPerPacket": 5
        },
        "Ip": {
          "Enable": false,
          "MaxPackets": 100,
          "WindowSeconds": 1
        },
        "Port": {
          "Enable": false,
          "MaxPackets": 100,
          "WindowSeconds": 1
        },
        "Protocol": {
          "Enable": false,
          "MaxPackets": 100,
          "WindowSeconds": 1
        }
      }
    }
  }
}