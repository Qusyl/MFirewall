{
  "FirewallConfiguration": {
    "RuleStrategy": "FIRST_MATCHING",
    "FirewallProtection": {
      "DestinationIpOptions": {
        "Enable": false,
        "DestinationAddress": "127.0.0.17"
      },
      "DestinationPortOptions": {
        "Enable": false,
        "DestinationPort": 778
      },
      "SourceIpOptions": {
        "Enable": false,
        "SourceAddress": "127.0.0.3"
      },
      "SourcePortOptions": {
        "Enable": false,
        "SourcePort": 779
      },
      "TcpPortScanOptions": {
        "Enable": false,
        "UniquePacketsThreshold": 11,
        "WindowSeconds": 3
      },
      "UdpPortScanOptions": {
        "Enable": false,
        "UniquePacketsThreshold": 12,
        "WindowSeconds": 3
      },
      "TcpSynFloodOptions": {
        "Enable": false,
        "MaxSynPackets": 110,
        "WindowSeconds": 3
      },
      "UdpFloodOptions": {
        "Enable": false,
        "MaxPackets": 301,
        "WindowSeconds": 3
      },
      "RateLimitOptions": {
        "Enable": true,
        "Algorithm": "TOKEN_BUCKET",
        "TokenBucket": {
          "Enable": true,
          "Capacity": 99,
          "TokenPerSeconds": 50,
          "TokenPerPacket": 5
        },
        "Ip": {
          "Enable": false,
          "MaxPackets": 6000,
          "WindowSeconds": 1
        },
        "Port": {
          "Enable": true,
          "MaxPackets": 100,
          "WindowSeconds": 1
        },
        "Protocol": {
          "Enable": false,
          "MaxPackets": 100,
          "WindowSeconds": 1
        }
      }
    }
  }
}