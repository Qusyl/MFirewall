<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MFirewallAppUI.AuthorizationWindow"
        x:CompileBindings="False"
        Title="Авторизация"
        Width="620" Height="760"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2563EB"/>
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#94A3B8"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.success">
            <Setter Property="Foreground" Value="#16A34A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="3"/>
            <Setter Property="IsIndeterminate" Value="True"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ProgressBar.visible">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Margin="40">

        <StackPanel Grid.Row="0" Margin="0,20,0,30" Spacing="8">
            <TextBlock Text="MFirewall" FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Войдите в свой аккаунт или создайте новый"
                       FontSize="14" Foreground="#666"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <TabControl Grid.Row="1" Name="AuthTabs">

            <!-- ================= LOGIN ================= -->
            <TabItem Header="Вход">
                <StackPanel Spacing="16" Margin="0,24,0,0">

                    <StackPanel>
                        <TextBlock Text="Email" Classes="label"/>
                        <TextBox Name="LoginEmail" Watermark="you@example.com"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Пароль" Classes="label"/>
                        <TextBox Name="LoginPassword"
                                 PasswordChar="●"
                                 Watermark="Введите пароль"/>
                    </StackPanel>

                    <TextBlock Name="LoginError" Classes="error" IsVisible="False"/>
                    <TextBlock Name="LoginSuccess" Classes="success" IsVisible="False"/>

                    <ProgressBar Name="LoginProgress" Classes="visible"/>

                    <Button Name="LoginButton"
                            Content="Войти"
                            Classes="primary"
                            Margin="0,10,0,0"
                            Click="OnLoginClick"/>
                </StackPanel>
            </TabItem>

            <!-- ================= REGISTER ================= -->
            <TabItem Header="Регистрация">
                <StackPanel Spacing="16" Margin="0,24,0,0">

                    <StackPanel>
                        <TextBlock Text="Email" Classes="label"/>
                        <TextBox Name="RegisterEmail" Watermark="you@example.com"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Пароль" Classes="label"/>
                        <TextBox Name="RegisterPassword"
                                 PasswordChar="●"
                                 Watermark="Минимум 6 символов"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Повторите пароль" Classes="label"/>
                        <TextBox Name="RegisterPasswordConfirm"
                                 PasswordChar="●"
                                 Watermark="Повторите пароль"/>
                    </StackPanel>

                    <TextBlock Name="RegisterError" Classes="error" IsVisible="False"/>
                    <TextBlock Name="RegisterSuccess" Classes="success" IsVisible="False"/>

                    <ProgressBar Name="RegisterProgress" Classes="visible"/>

                    <Button Name="RegisterButton"
                            Content="Создать аккаунт"
                            Classes="primary"
                            Margin="0,10,0,0"
                            Click="OnRegisterClick"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>